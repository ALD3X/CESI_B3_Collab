# Front servi par NGINX (non-root, port 8080). Les appels /api sont relayés à la passerelle choisie
# (variables PASSERELLE_HOTE / PASSERELLE_NOM / BUS injectées au démarrage du conteneur).
server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri /index.html;
    }

    # Pile technique affichée dans l'en-tête de la boutique
    location = /config.json {
        default_type application/json;
        return 200 '{"passerelle":"${PASSERELLE_NOM}","bus":"${BUS}"}';
    }

    # Flux de notifications en direct (SSE) : pas de mise en tampon
    location /api/notifications/flux {
        proxy_pass http://${PASSERELLE_HOTE};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass http://${PASSERELLE_HOTE};
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
