// Pipeline CI/CD de la boutique — Jenkins (scénario de référence US-04.1)
// Étapes identiques à .github/workflows/ci.yml, mêmes outils et mêmes scripts (ci/*.sh) :
//   secrets ‖ backend (tests + couverture) ‖ front (tests + couverture) ‖ SAST + SCA
//   → build des 9 images → scan des images → test de bout en bout → publication (main)
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 40, unit: 'MINUTES')
    }

    environment {
        TRIVY_IMAGE = 'aquasec/trivy:0.65.0'
        // Registre local lancé avec Jenkins (équivalent de GHCR côté GitHub)
        REGISTRE    = 'localhost:5000/'
        TAG         = "build-${env.BUILD_NUMBER}"
    }

    stages {
        // ---------- 1. Qualité et sécurité du code (4 branches en parallèle) ----------
        stage('Qualité et sécurité du code') {
            parallel {
                stage('Secrets (gitleaks)') {
                    agent { docker { image 'zricethezav/gitleaks:v8.24.3'; args '--entrypoint='; reuseNode true } }
                    steps {
                        sh 'gitleaks dir . --no-banner --redact'
                    }
                }
                stage('Backend : tests + couverture') {
                    agent { docker { image 'maven:3.9-eclipse-temurin-21'; args '-v boutique-m2:/root/.m2'; reuseNode true } }
                    steps {
                        sh 'mvn -B -ntp -f backend/pom.xml verify'
                    }
                    post {
                        always { junit allowEmptyResults: true, testResults: 'backend/*/target/surefire-reports/*.xml' }
                    }
                }
                stage('Front : tests + couverture') {
                    agent { docker { image 'node:20-alpine'; reuseNode true } }
                    steps {
                        dir('front') {
                            sh 'npm ci && npm test'
                        }
                    }
                }
                stage('SAST (Semgrep) + SCA (Trivy)') {
                    stages {
                        stage('SAST') {
                            agent { docker { image 'semgrep/semgrep:1.99.0'; reuseNode true } }
                            steps {
                                sh '''semgrep scan --config p/java --config p/react --config p/secrets \
                                      --severity ERROR --error --metrics off --exclude "**/target" \
                                      --exclude front/node_modules .'''
                            }
                        }
                        stage('SCA') {
                            agent { docker { image 'aquasec/trivy:0.65.0'; args '--entrypoint='; reuseNode true } }
                            steps {
                                sh '''trivy fs --quiet --scanners vuln --severity CRITICAL --ignore-unfixed \
                                      --skip-dirs front/node_modules --exit-code 1 .'''
                            }
                        }
                    }
                }
            }
        }

        // ---------- 2. Images, scan, test de bout en bout, publication ----------
        stage('Build des 9 images') {
            steps {
                sh 'docker compose build'
            }
        }

        stage('Scan des images (trivy)') {
            steps {
                sh 'sh ci/scan-images.sh'
            }
        }

        stage('Test de bout en bout') {
            steps {
                sh 'sh ci/smoke-test.sh "boutique-ci-${BUILD_NUMBER}"'
            }
        }

        stage('Publication (main uniquement)') {
            when { expression { env.GIT_BRANCH?.endsWith('main') } }
            steps {
                sh 'docker compose push'
                echo "Images publiées : ${env.REGISTRE}boutique-*:${env.TAG}"
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'backend/*/target/site/jacoco/**, front/coverage/**', allowEmptyArchive: true
        }
        success { echo 'Pipeline VERT : livrable prêt.' }
        failure { echo 'Pipeline ROUGE : une quality gate a bloqué la livraison.' }
    }
}
