// Pipeline CI/CD — démo Jenkins (scénario de référence US-04.1)
// Étapes identiques à .github/workflows/ci.yml : secrets → lint/tests → SAST/SCA → build → scan image → smoke test → publication
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 20, unit: 'MINUTES')
    }

    environment {
        TRIVY_IMAGE    = 'aquasec/trivy:0.65.0'
        // Registre local lancé par docker compose (équivalent de GHCR côté GitHub)
        IMAGE          = "localhost:5000/petite-maison/catalogue:build-${env.BUILD_NUMBER}"
    }

    stages {
        // ---------- 1. Qualité et sécurité du code (3 branches en parallèle) ----------
        stage('Qualité et sécurité du code') {
            parallel {
                stage('Secrets (gitleaks)') {
                    agent { docker { image 'zricethezav/gitleaks:v8.24.3'; args '--entrypoint='; reuseNode true } }
                    steps {
                        sh 'gitleaks dir . --no-banner --redact'
                    }
                }
                stage('Lint + tests unitaires') {
                    agent { docker { image 'python:3.12-slim'; reuseNode true } }
                    steps {
                        sh '''
                            python -m venv /tmp/venv && . /tmp/venv/bin/activate
                            pip install -q -r requirements-dev.txt
                            ruff check .
                            mkdir -p reports
                            pytest --junitxml=reports/junit.xml --cov=app --cov-report=xml:reports/coverage.xml \
                                   --cov-report=term --cov-fail-under=80
                        '''
                    }
                    post {
                        always { junit allowEmptyResults: true, testResults: 'reports/junit.xml' }
                    }
                }
                stage('SAST (bandit) + SCA (pip-audit)') {
                    agent { docker { image 'python:3.12-slim'; reuseNode true } }
                    steps {
                        sh '''
                            python -m venv /tmp/venv && . /tmp/venv/bin/activate
                            pip install -q -r requirements-dev.txt
                            bandit -r app -lll
                            pip-audit -r requirements.txt
                        '''
                    }
                }
            }
        }

        // ---------- 2. Build, scan de l'image, smoke test, publication ----------
        stage('Build de l\'image') {
            steps {
                sh 'docker build -t "$IMAGE" .'
            }
        }

        stage('Scan de l\'image (trivy)') {
            steps {
                sh '''
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache \
                        "$TRIVY_IMAGE" image --quiet --severity CRITICAL --ignore-unfixed --exit-code 1 "$IMAGE"
                '''
            }
        }

        stage('Smoke test') {
            steps {
                sh 'sh ci/smoke-test.sh "$IMAGE" "smoke-$BUILD_TAG"'
            }
        }

        stage('Publication (main uniquement)') {
            when { expression { env.GIT_BRANCH?.endsWith('main') } }
            steps {
                sh 'docker push "$IMAGE"'
                echo "Image publiée : ${env.IMAGE}"
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
        }
        success { echo 'Pipeline VERT : livrable prêt.' }
        failure { echo 'Pipeline ROUGE : une quality gate a bloqué la livraison.' }
    }
}
